<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grandma's Loyalty Card</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
:root{--bg:#ffe8c2;--bg2:#ffd08a;--card:#fff6e3;--ink:#4a2c1a;--acc:#e0642b;--red:#d7263d;--line:#4a2c1a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#3a2214;--bg2:#2a170d;--card:#5a3720;--ink:#ffe8c2;--line:#1b0e06}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;min-height:100vh;background:linear-gradient(var(--bg),var(--bg2));color:var(--ink);font:400 11px/1.8 "Press Start 2P","Courier New",monospace;text-align:center}
.px{image-rendering:pixelated;image-rendering:crisp-edges;display:block;margin:0 auto}
.wrap{max-width:560px;margin:auto;padding:18px 14px 40px}
h1{margin:6px 0 0;font-size:14px;line-height:1.6;color:var(--acc);text-shadow:2px 2px 0 var(--line);font-weight:400;letter-spacing:1px}
.card{background:var(--card);border:4px solid var(--line);padding:12px;margin:14px 0;box-shadow:5px 5px 0 var(--line)}
.big{font:inherit;font-size:10px;color:#fff;background:var(--acc);border:4px solid var(--line);padding:12px 14px;margin:8px 4px 0;box-shadow:4px 4px 0 var(--line);cursor:pointer;text-decoration:none;display:inline-block}
.big:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--line)}.alt{background:var(--card);color:var(--ink)}
.lc{border:6px solid var(--line);box-shadow:6px 6px 0 var(--line);margin:14px 0;background:var(--card);color:#4a2c1a}
.lc-head{background:var(--acc);color:#fff;padding:12px 8px;border-bottom:6px solid var(--line);font-size:11px;line-height:1.7}
.lc-name{display:inline-block;margin-top:6px;background:#fff;color:#4a2c1a;padding:2px 8px;border:3px solid var(--line);font-size:9px}
.lc-body{padding:12px;background:conic-gradient(#fff6e3 25%,#ffeccb 0 50%,#fff6e3 0 75%,#ffeccb 0) 0 0/16px 16px}
.slots{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.slot{aspect-ratio:1;border:4px dashed #b9803f;background:#fff;display:flex;align-items:center;justify-content:center;position:relative;color:#c9a27a;overflow:hidden}
.slot.on{border:4px solid var(--line);background:#ffe3b8}
.slot.prize{border-color:var(--red);color:var(--red)}
.slot small{font-size:6px;line-height:1.5}
.slot .num{position:absolute;top:1px;left:3px;font-style:normal;font-size:7px;opacity:.7}
.slot img.st{width:62%;height:auto;animation:stamp .3s steps(3)}
.slot img.mk{width:46%;height:auto;animation:bob .8s steps(2) infinite}
@keyframes stamp{0%{transform:scale(1.8);opacity:0}100%{transform:none;opacity:1}}
@keyframes bob{50%{transform:translateY(-5px)}}
.lc-msg{margin-top:12px;font-size:9px;line-height:1.8}
.prizes .pz{border:3px dashed var(--red);background:#fff;color:#4a2c1a;margin:8px 0 0;padding:6px;font-size:8px;line-height:1.6}
</style></head><body><div class="wrap">
<h1>GRANDMA'S<br>LOYALTY CARD</h1>
<div class="lc"><div class="lc-head">COLLECT 10 STAMPS<br><span id="lc-name" class="lc-name">GUEST</span></div>
<div class="lc-body"><div class="slots" id="slots"></div><div id="lc-msg" class="lc-msg"></div><button class="big" id="lc-redeem" style="display:none">I REDEEMED IT - NEW CARD</button></div></div>
<div class="card"><div style="font-size:10px">YOUR PRIZES</div><div id="lc-prizes" class="prizes"></div></div>
<a class="big alt" href="fall-parfait-game.html">PLAY THE GAME</a>
<button class="big alt" id="lc-demo" style="font-size:8px">DEMO: +1 STAMP</button>
</div>
<script>
/* pixel sprites (same art as the game) */
const PAL={k:'#4a2c1a',w:'#ffffff',c:'#fff3cf',o:'#e0642b',t:'#d9a15b',r:'#d7263d',g:'#4f9a3c'};
const SPR={
marker:["...kkk...","...krk...","...krk...","kkkkrkkkk","krrrrrrrk",".krrrrrk.","..krrrk..","...krk...","....k...."],
parfait:["......gg......",".....krrk.....","....kkwwkk....","...kwwwwwwk...","..kwwwwwwwwk..",".kwwwwwwwwwwk.",".kkkkkkkkkkkk.",".kcccccccccck.",".kooooooooook.",".kttttttttttk.",".kcccccccccck.",".kooooooooook.","..kccccccccck.","...kcccccck...",".....kwwk.....",".....kwwk.....","...kkkkkkkk..."]
};
const cache={};
function spr(k){if(cache[k])return cache[k];const rows=SPR[k],W=Math.max(10,...rows.map(r=>r.length)),H=Math.max(10,rows.length),c=document.createElement('canvas');c.width=W;c.height=H;
 const x=c.getContext('2d'),W0=Math.max(...rows.map(r=>r.length)),top=H-rows.length,left=Math.floor((W-W0)/2);
 rows.forEach((r,j)=>[...r.padEnd(W0,'.')].forEach((ch,i)=>{if(PAL[ch]){x.fillStyle=PAL[ch];x.fillRect(i+left,j+top,1,1)}}));
 return cache[k]={u:c.toDataURL()}}
/* loyalty card (stamps live in this browser's localStorage, shared with the game page) */
const $=i=>document.getElementById(i),GOAL=10;let mem=0;
function stamps(){try{return Math.min(GOAL,+localStorage.getItem('gb_stamps')||0)}catch(e){return mem}}
function setStamps(n){mem=n;try{localStorage.setItem('gb_stamps',n)}catch(e){}}
function addStamp(){const n=stamps();if(n>=GOAL){renderCard();return false}setStamps(n+1);renderCard();return true}
function renderCard(){const n=stamps();let nm='';try{nm=localStorage.getItem('gb_name')||''}catch(e){}
 $('lc-name').textContent=nm?nm.toUpperCase().slice(0,16):'GUEST';
 $('slots').innerHTML=Array.from({length:GOAL},(_,i)=>{const on=i<n,nx=i==n&&n<GOAL,pz=i==GOAL-1;
  const inner=on?`<img class="px st" alt="stamp" src="${spr('parfait').u}">`:nx?`<img class="px mk" alt="next stamp goes here" src="${spr('marker').u}">`:pz?'<small>FREE<br>PARFAIT</small>':'';
  return `<div class="slot${on?' on':''}${pz?' prize':''}"><i class="num">${i+1}</i>${inner}</div>`}).join('');
 $('lc-msg').textContent=n>=GOAL?'CARD FULL! SHOW IT AT THE COUNTER FOR YOUR FREE PARFAIT!':`${n} OF ${GOAL} STAMPS - ${GOAL-n} MORE FOR A FREE PARFAIT!`;
 $('lc-redeem').style.display=n>=GOAL?'inline-block':'none';
 let L=[];try{L=JSON.parse(localStorage.getItem('gb_members')||'[]')}catch(e){}
 $('lc-prizes').innerHTML=L.length?L.slice(-3).reverse().map(m=>`<div class="pz">${m.prize}<br><b>${m.code}</b></div>`).join(''):'<div class="pz">NO PRIZES YET - WIN THE GAME!</div>'}
$('lc-redeem').onclick=()=>{setStamps(0);renderCard()};
$('lc-demo').onclick=addStamp;
renderCard();
</script></body></html>
